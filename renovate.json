{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Go tools pinned with a `# renovate:` comment on the line above the version (deadcode, nilaway)",
      "managerFilePatterns": [
        "/^nix/scripts/.+\\.bash$/",
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Za-z_][A-Za-z0-9_]*[=:] *(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Pin digests for GitHub Actions",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Group all indirect Go dependencies (major, minor, patch in one PR)",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "groupName": "go-indirect",
      "enabled": true,
      "separateMajorMinor": false,
      "separateMultipleMajor": false,
      "separateMinorPatch": false
    },
    {
      "description": "Never bump indirect Go deps across majors. A new major is a different module path; nothing in this repo imports it, so go mod tidy just strips the new lines again.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group Charmbracelet dependencies",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require"],
      "groupName": "charmbracelet",
      "matchPackageNames": [
        "charm.land/{/,}**",
        "github.com/charmbracelet/{/,}**"
      ]
    },
    {
      "description": "Group golang.org/x dependencies",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require"],
      "groupName": "golang-x",
      "matchPackageNames": [
        "golang.org/x/{/,}**"
      ]
    },
    {
      "description": "Group Gorm dependencies",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require"],
      "groupName": "gorm",
      "matchPackageNames": [
        "gorm.io/{/,}**"
      ]
    },
    {
      "description": "Group Docker image updates",
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker-images"
    },
    {
      "description": "Automerge GitHub Actions patch updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "digest"]
    }
  ]
}
